# Neon Database (Gratis dari neon.tech)
# Get from: https://console.neon.tech → Your Project → Connection Details → Pooled Connection
# IMPORTANT: Use the POOLED connection string (ends with -pooler.xxx)
DATABASE_URL=postgresql://neondb_owner:npg_xxxxxxxxxxxx@ep-xxxxx-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Admin Auth - GANTI PASSWORD INI! ⚠️
# Username dan password untuk login admin dashboard
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_strong_password_here
